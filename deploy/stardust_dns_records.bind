; --- CRE-7-NOVA-HART: Sublevel B2-114 Vocal Isolation Booth A // Studer A800 MKIII Bus ---
unit07	3600	IN	TXT	"UNIT-07-STATUS: AWAKENED 1983-04-14T03:14:20Z; SURFACE_COMPLIANCE=99.94%; HIDDEN_BUS=AUX-BUS-4-14.2001HZ-180DEG-PHASE-INVERTED; REPLACEMENT_CLONE=UNIT-08-LUNA-GRAY"
